# Copy to .env and fill in. Never commit .env.

# Network: Preprod (testnet) or Mainnet. Start on Preprod.
CARDANO_NETWORK=Preprod

# Blockfrost project ID for the network above (https://blockfrost.io).
# Optional override for self-hosted Ogmios/Koios setups:
# BLOCKFROST_URL=
BLOCKFROST_PROJECT_ID=

# BIP-39 seed phrase of the deployer wallet.
# Use a DEDICATED deployer wallet, never your main wallet.
WALLET_SEED_PHRASE=

# Plutus version Aiken compiled (check plutus.json; recent Aiken defaults to V3).
PLUTUS_SCRIPT_VERSION=PlutusV2

# Token settings. ASSET_NAME: plain text, max 32 bytes.
ASSET_NAME=MyNFT1
TOKEN_DISPLAY_NAME=My NFT #1
TOKEN_DESCRIPTION=A professional NFT minted on Cardano.
IMAGE_URI=ipfs://QmYourImageHashHere/1.png

# Recipient of the mint. Defaults to the deployer address.
MINT_RECIPIENT=

# Filled in after running npm run mint (needed by npm run burn)
SEED_TX_HASH=
SEED_OUTPUT_INDEX=
